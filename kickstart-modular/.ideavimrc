" NOTE: Copy and paste this snippet into init.lua. It will export the keybindings to the target file, 
" then use AI to convert it
" to a format .ideavimrc will understand
"
" NOTE: remember to enable IdeaVim: Track Action IDs in Intellij to show the id of functions to map the
" keybindings to.
"
" local function export_keymaps()
"     local modes = { 'n', 'i', 'v', 'x', 's', 'o', '!', 'l', 'c', 't' }
"     local output = {}
"
"     for _, mode in ipairs(modes) do
"         local keymaps = vim.api.nvim_get_keymap(mode)
"         if #keymaps > 0 then
"             output[#output + 1] = 'Mode: ' .. mode
"             for _, keymap in ipairs(keymaps) do
"                 local line = string.format('%s -> %s', keymap.lhs, keymap.rhs or keymap.callback or '')
"                 if keymap.desc then
"                     line = line .. ' (' .. keymap.desc .. ')'
"                 end
"                 output[#output + 1] = line
"             end
"             output[#output + 1] = ''
"         end
"     end
"
"     local file = io.open('keybindings.txt', 'w')
"     if file then
"         file:write(table.concat(output, '\n'))
"         file:close()
"         print 'Keymaps exported to keybindings.txt in the current directory'
"     else
"         print 'Failed to open keybindings.txt for writing'
"     end
" end
"
" -- export_keymaps()


" Basic settings
set incsearch
set hlsearch
set ignorecase
set smartcase
set showmode
set number
set relativenumber
set ideajoin
set idearefactormode=keep

" Clear search highlighting with Esc
nnoremap <Esc> :noh<CR>

" Window navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Yank to end of line
nnoremap Y y$

" Leader key
let mapleader = " "

nnoremap <leader>rv :action IdeaVim.ReloadVimRc.reload<CR>

" Search mappings
nnoremap <leader>sf :action GotoFile<CR>
nnoremap <leader>sg :action FindInPath<CR>
nnoremap <leader>sd :action ShowErrorDescription<CR>
nnoremap <leader>sn :action GotoClass<CR>
nnoremap <leader>ss :action SearchEverywhere<CR>
nnoremap <leader>sh :action FindUsages<CR>

" Git mappings
nnoremap <leader>sgf :action Git.Menu<CR>

" LSP-like mappings
nnoremap gd :action GotoDeclaration<CR>
nnoremap gi :action GotoImplementation<CR>
nnoremap gr :action FindUsages<CR>
nnoremap <leader>rn :action RenameElement<CR>

" Diagnostics navigation
nnoremap [d :action GotoPreviousError<CR>
nnoremap ]d :action GotoNextError<CR>

" Comment toggling
nnoremap gcc :action CommentByLineComment<CR>
vnoremap gc :action CommentByLineComment<CR>

" Format buffer
nnoremap <leader>f :action ReformatCode<CR>

" Todo comments (not exact, but similar functionality)
nnoremap <leader>st :action ActivateTODOToolWindow<CR>

" Surround emulation (requires IdeaVim-EasyMotion plugin)
set surround

" Quick documentation
nnoremap K :action QuickJavaDoc<CR>

" Terminal
nnoremap <leader>t :action ActivateTerminalToolWindow<CR>

" NERDTree-like file explorer
nnoremap \ :action ActivateProjectToolWindow<CR>

" Telescope-like fuzzy finder (not exact, but similar)
nnoremap <leader><leader> :action SearchEverywhere<CR>

" Buffer navigation
nnoremap <leader>b :action Switcher<CR>

" Reload .ideavimrc
nnoremap <leader>sv :source ~/.ideavimrc<CR>
